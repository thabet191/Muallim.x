# Copy this file to .env and fill in the values.

# A Postgres connection string — used both locally and in production so the
# two environments behave the same. A free database works fine to start:
# https://neon.tech (or Vercel Postgres / Supabase). Copy the connection
# string it gives you here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session signing secret. Generate one with: npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# Required for the teacher chat — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Model used for the tutoring chat. Haiku keeps per-student cost low (~$1-3/mo);
# switch to a Sonnet model id for higher-quality explanations at higher cost.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
